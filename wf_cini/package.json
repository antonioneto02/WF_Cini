{
  "name": "wf-cini-bpm",
  "version": "1.0.0",
  "description": "Workflow BPM corporativo no ERP CINI",
  "main": "server.js",
  "scripts": {
    "start": "title Workflow Cini && node server.js",
    "dev": "title Workflow Cini && nodemon server.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test": "npm run test:unit",
    "test:integracao": "node --test --test-concurrency=1 tests/integracao/",
    "db:criar:postgres": "node scripts/executar-sql.js database/sql/postgres/create_tables.sql",
    "db:migrar:postgres": "node scripts/migrar-para-postgres.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bpmn-moddle": "^9.0.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mssql": "^11.0.1",
    "mysql2": "^3.11.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cls-hooked": "^4.2.2",
    "eslint": "^10.8.1",
    "eslint-plugin-security": "^4.0.1",
    "nodemon": "^3.1.7"
  }
}
